FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System deps kept minimal (uvicorn[standard] may need some wheels; slim is OK)
RUN python -m pip install --no-cache-dir --upgrade pip

# Install gateway runtime deps (prefer repo-provided file; create minimal if missing)
COPY requirements-gateway.txt /app/requirements-gateway.txt
RUN pip install --no-cache-dir -r /app/requirements-gateway.txt

# App code
COPY src /app/src
COPY configs /app/configs
COPY README.md /app/README.md

ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uvicorn", "bist_core.gateway.app:app", "--host", "0.0.0.0", "--port", "8000"]
