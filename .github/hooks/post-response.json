{
    "name": "post-response-validator",
    "trigger": "after_response",
    "allowedReportContracts": [
        [
            "RESULT",
            "VALIDATION",
            "PR",
            "MERGE_METHOD",
            "MAIN_HEAD",
            "FINAL_GIT_STATUS",
            "NEXT_BLOCKER"
        ],
        [
            "WHAT WAS ANALYZED",
            "WHAT WAS FOUND",
            "WHAT WAS FIXED",
            "WHY IT WORKS",
            "RISKS"
        ]
    ],
    "rules": [
        {
            "type": "require_sections",
            "sections": [
                "RESULT",
                "VALIDATION",
                "PR",
                "MERGE_METHOD",
                "MAIN_HEAD",
                "FINAL_GIT_STATUS",
                "NEXT_BLOCKER"
            ],
            "error": "INVALID RESPONSE STRUCTURE"
        },
        {
            "type": "reject_if",
            "condition": "contains_hallucination == true",
            "error": "HALLUCINATION DETECTED"
        },
        {
            "type": "reject_if",
            "condition": "missing_data_used == true",
            "error": "INVALID DATA USAGE"
        }
    ]
}