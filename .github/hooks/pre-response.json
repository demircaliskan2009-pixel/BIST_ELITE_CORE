{
    "name": "pre-response-guard",
    "trigger": "before_response",
    "allowedReportContracts": [
        [
            "RESULT",
            "VALIDATION",
            "PR",
            "MERGE_METHOD",
            "MAIN_HEAD",
            "FINAL_GIT_STATUS",
            "NEXT_BLOCKER"
        ],
        [
            "WHAT WAS ANALYZED",
            "WHAT WAS FOUND",
            "WHAT WAS FIXED",
            "WHY IT WORKS",
            "RISKS"
        ]
    ],
    "rules": [
        {
            "type": "require_field",
            "field": "task_type",
            "error": "TASK CLASSIFICATION MISSING"
        },
        {
            "type": "require_field",
            "field": "selected_prompt",
            "error": "PROMPT NOT SELECTED"
        },
        {
            "type": "reject_if",
            "condition": "context == null || context == insufficient",
            "error": "INSUFFICIENT EVIDENCE"
        },
        {
            "type": "reject_if",
            "condition": "response_style == template",
            "error": "TEMPLATE RESPONSE FORBIDDEN"
        }
    ]
}