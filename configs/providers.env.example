# Live adaptive portfolio gates (bist_core.live.adaptive_live_controller):
# BIST_ADAPTIVE_MODE=1|0  BIST_ADAPTIVE_WINDOW=50
# BIST_EDGE_MEMORY_LEN=20

# Execution intelligence (bist_core.live.execution_intelligence + live_runner):
# BIST_EXEC_INTEL=1|0
# BIST_EXEC_PARTIAL=1|0   # 50% + 50% staged entries when 1
# BIST_EXEC_MIN_FILL_PROB=0.34   # below → delay bar (deterministic)
# BIST_EXEC_CHOPPY_DELAY=1|0     # delay entries when regime is CHOPPY

# Risk engine (bist_core.live.risk_engine + portfolio + live_runner):
# BIST_RISK_ENGINE=1|0
# BIST_RISK_MAX_POSITIONS=3
# BIST_RISK_MAX_SYMBOL_FRACTION=0.30
# BIST_RISK_VOL_HIGH=0.05
# BIST_RISK_VOL_EXTREME=0.12   # pause entries when vol proxy ≥ this
# BIST_RISK_PAUSE_CYCLES=12    # loss streak ≥5 pause length

# Market realism (bist_core.execution.realistic_execution_engine + PaperExecution):
# BIST_REALISM_DEBUG=1   # verbose per-fill diagnostics

# Long-run validation (see docs/SYSTEM_VALIDATION.md, tools/run_system_validation.ps1):
# PYTHONPATH=src  BIST_LIVE_MAX_CYCLES=800  BIST_LIVE_POLL_SECONDS=0
# BIST_SYMBOLS=ASELS,THYAO,...   then: python -m bist_core.validation --input validation_run.txt

# Auto-optimizer (tools/optimizer_env.ps1 — written by auto_optimizer, do not hand-edit):
