{
  "components": {
    "schemas": {
      "CliRequest": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "description": "Arguments after 'bist_core.cli' module. Example: ['data','snapshots','doctor','--json']",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "timeout_s": {
            "default": 30,
            "maximum": 120,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "args"
        ],
        "type": "object"
      },
      "CliResponse": {
        "additionalProperties": false,
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "stderr": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          }
        },
        "required": [
          "returncode",
          "stdout",
          "stderr"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Contract for the optional HTTP Gateway. Auth/rate-limit will be added later.",
    "title": "BIST_ELITE_CORE Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Health status"
          }
        }
      }
    },
    "/v1/cli": {
      "post": {
        "operationId": "runCli",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CliRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CliResponse"
                }
              }
            },
            "description": "CLI execution result"
          },
          "400": {
            "description": "Bad request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}
